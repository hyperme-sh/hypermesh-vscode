{
  "name": "hypermesh-vscode",
  "displayName": "Hypermesh",
  "description": "Hypermesh assigned Visor chat and tool connections through Conductor.",
  "version": "0.1.0",
  "publisher": "fyberlabs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "extensionKind": ["workspace"],
  "contributes": {
    "commands": [
      {
        "command": "hypermesh.smoke",
        "title": "Hypermesh: smoke"
      },
      {
        "command": "hypermesh.chat",
        "title": "Hypermesh: Chat with Visor"
      },
      {
        "command": "hypermesh.cancel",
        "title": "Hypermesh: Cancel Visor turn"
      },
      {
        "command": "hypermesh.attachTools",
        "title": "Hypermesh: Manage Visor tool connections"
      },
      {
        "command": "hypermesh.permissions",
        "title": "Hypermesh: Inspect and manage workspace permissions"
      },
      {
        "command": "hypermesh.continue",
        "title": "Hypermesh: Continue task controls"
      },
      {
        "command": "hypermesh.terminalTask",
        "title": "Hypermesh: Visor terminal task"
      },
      {
        "command": "hypermesh.cloudWorkspace",
        "title": "Hypermesh: Cloud workspace task"
      },
      {
        "command": "hypermesh.lintFile",
        "title": "Hypermesh: Lint current JSON file with Visor"
      }
    ],
    "configuration": {
      "title": "Hypermesh",
      "properties": {
        "hypermesh.apiBase": {
          "type": "string",
          "default": "https://chat.test.hyperme.sh",
          "description": "Chat host. Smoke posts /v1/chat/completions here. Not the control-plane stub.",
          "scope": "machine"
        },
        "hypermesh.tenant": {
          "type": "string",
          "default": "",
          "description": "Tenant id sent as X-Tenant-ID.",
          "scope": "machine"
        },
        "hypermesh.acpExecutable": {
          "type": "string",
          "default": "",
          "description": "Absolute installed hypermesh-acp executable path. User settings only; never a project command.",
          "scope": "machine"
        },
        "hypermesh.visorSocket": {
          "type": "string",
          "default": "",
          "description": "Private Visor companion socket path. User settings only. No API key is sent.",
          "scope": "machine"
        },
        "hypermesh.terminalHostDeviceId": {
          "type": "string",
          "default": "",
          "description": "Expected enrolled Visor device UUID for terminal tasks in a Remote SSH workspace. Set in Remote Settings.",
          "scope": "machine"
        },
        "hypermesh.cloudWorkspaceTask": {
          "type": "object",
          "default": {},
          "description": "Selected cloud workspace task on the enrolled Linux worker. Set in User or Remote Settings.",
          "scope": "machine",
          "properties": {
            "executable": { "type": "string", "description": "Absolute installed headless Visor executable path." },
            "device_id": { "type": "string" },
            "worker_generation": { "type": "integer", "minimum": 1 },
            "task_id": { "type": "string" },
            "lease_id": { "type": "string" }
          }
        },
        "hypermesh.companionExecutable": {
          "type": "string",
          "default": "",
          "description": "Absolute installed hypermesh-companion executable path for reviewed tool connections.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test src/*.test.js",
    "package": "vsce package --no-dependencies --out dist/hypermesh-vscode.vsix",
    "check": "bash scripts/check-package.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperme-sh/hypermesh-vscode.git"
  },
  "private": true,
  "devDependencies": {
    "@vscode/vsce": "4.1.0"
  },
  "license": "Apache-2.0",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Visor terminal tasks require a trusted local, WSL, or Remote SSH workspace. Workspace lint requires a trusted local workspace."
    }
  }
}
